<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BrowserGuard</RootNamespace>
    <AssemblyName>BrowserGuard</AssemblyName>
    <LangVersion>latest</LangVersion>
    <StartupObject>BrowserGuard.Program</StartupObject>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>BrowserGuard</Company>
    <Product>BrowserGuard</Product>
    <Description>Windows application that monitors your default browser and automatically resets it to your preferred browser</Description>
    <Copyright>Copyright © 2026</Copyright>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Update="set-default-browser.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>